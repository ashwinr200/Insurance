apiVersion: apps/v1
kind: Deployment
metadata:
  name: insurance-app
  labels:
    app: insurance
spec:
  replicas: 1
  selector:
    matchLabels:
      app: insurance
  template:
    metadata:
      labels:
        app: insurance
    spec:
      containers:
      - name: insurance-container
        image: ashwinr2001/insurancedev:{{ build_tag }}
        ports:
        - containerPort: 8081
---
apiVersion: v1
kind: Service
metadata:
  name: insurance-service
spec:
  selector:
    app: insurance
  ports:
    - protocol: TCP
      port: 8082         # Cluster-internal port
      targetPort: 8082   # Container port
      nodePort: 30002     # External port on EC2 host
  type: NodePort
